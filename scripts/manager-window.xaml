<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Dragon Studio · 主题管理器" Width="1060" Height="740" MinWidth="920" MinHeight="660" WindowStartupLocation="CenterScreen" Background="#F5F3EF" FontFamily="Microsoft YaHei UI">
<Window.Resources><Style TargetType="Button"><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#D9D5CE"/><Setter Property="Foreground" Value="#343C39"/></Style><Style TargetType="ComboBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,8,0,18"/></Style></Window.Resources>
<Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Margin="0,0,0,22"><TextBlock Text="DRAGON / STUDIO" FontSize="12" Foreground="#748078"/><TextBlock Text="让工作界面，成为自己的空间。" FontSize="27" Margin="0,8,0,6"/><TextBlock Text="本地视频主题 · 安全预设 · 即时切换" Foreground="#777B76"/></StackPanel>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
<Grid Margin="0,0,26,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="#202723" CornerRadius="8" Padding="8"><MediaElement x:Name="Preview" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" Volume="0"/></Border><StackPanel Grid.Row="1" Margin="0,16,0,0"><TextBlock Text="你的主题库" FontSize="18"/><TextBlock Text="配色预设改变强调色、面板色与背景色；保留透出滑块值。" Foreground="#777B76" Margin="0,6,0,12"/><WrapPanel><Button x:Name="Import" Content="＋ 导入 MP4"/><Button x:Name="Gallery" Content="浏览在线主题库 ↗"/><Button x:Name="Studio" Content="在线创作 ↗"/></WrapPanel><TextBlock Text="在线主题库在浏览器打开。此版只接收本地 MP4，暂不导入图片或 ZIP 主题包。" TextWrapping="Wrap" Foreground="#777B76" FontSize="11"/></StackPanel></Grid>
<StackPanel Grid.Column="1"><TextBlock Text="视频素材" FontSize="13"/><ComboBox x:Name="Videos" DisplayMemberPath="Name"/><TextBlock Text="配色预设"/><ComboBox x:Name="Presets" DisplayMemberPath="Name"/><StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Border x:Name="AccentSwatch" Width="80" Height="20" Margin="0,0,6,0" ToolTip="强调色"/><Border x:Name="PanelSwatch" Width="80" Height="20" Margin="0,0,6,0" ToolTip="面板色"/><Border x:Name="BackgroundSwatch" Width="80" Height="20" ToolTip="背景色"/></StackPanel><TextBlock x:Name="RevealLabel" Text="壁纸透出 · 90%"/><Slider x:Name="Reveal" Minimum="0" Maximum="100" Value="90" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,12,0,20"/><Button x:Name="Apply" Content="应用到 Codex" Background="#315745" Foreground="White" BorderBrush="#315745"/><WrapPanel><Button x:Name="Pause" Content="暂停壁纸"/><Button x:Name="Resume" Content="恢复壁纸"/></WrapPanel><Separator Margin="0,10,0,16"/><TextBlock Text="下次启动模式"/><WrapPanel Margin="0,10,0,0"><Button x:Name="Normal" Content="普通模式"/><Button x:Name="Wallpaper" Content="壁纸模式"/></WrapPanel><TextBlock Text="切换启动模式后，保存工作并完全退出 Codex，再从动画入口打开。暂停壁纸不会关闭调试端口。" TextWrapping="Wrap" Foreground="#777B76" FontSize="11"/><Button x:Name="Hide" Content="收起到托盘" Margin="0,20,0,0"/></StackPanel>
</Grid><TextBlock Grid.Row="2" x:Name="Status" Text="素材自动入库 · 预览后手动应用到 Codex。" TextWrapping="Wrap" Foreground="#526558" Margin="0,22,0,0"/>
</Grid></Window>